{
  "permissions": {
    "allow": [
      "Bash(gh project item-edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Read(~/.sophon/keys/**)",
      "Bash(cat ~/.sophon/keys/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "for f in $CLAUDE_FILE_PATHS; do case \"$f\" in *.md) npx --yes markdownlint-cli2 --fix \"$f\" 2>/dev/null || true ;; esac; done"
          }
        ]
      }
    ]
  }
}
