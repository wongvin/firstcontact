<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle identity, supplied via $(…) since GENERATE_INFOPLIST_FILE is off.
	     Same arrangement as ios/FirstContact. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Core Bluetooth, both roles. Without this string the OS kills the app the
	     moment CBCentralManager or CBPeripheralManager is constructed. One key
	     covers central and peripheral, but the wording is what the user reads,
	     so it names both. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connects to your Sophon motion sensors, and lets this device act as one.</string>

	<!-- CoreMotion. Raw CMMotionManager accelerometer and gyroscope access is
	     NOT gated by the Motion & Fitness permission -- that gates
	     CMMotionActivityManager, CMPedometer and CMAltimeter -- so no prompt
	     appears for what this app actually does. Declared anyway: the penalty
	     for guessing wrong is a hard TCC termination rather than a graceful
	     denial, and an unused usage string costs nothing, since the prompt is
	     triggered by the API call and never by the key's presence. -->
	<key>NSMotionUsageDescription</key>
	<string>Reads this device's accelerometer and gyroscope so it can act as a simulated Sophon motion sensor.</string>

	<!-- Location is used ONLY to keep the app scheduled while it is streaming in
	     the background. No location is read, stored or transmitted.
	     See Simulator/BackgroundKeepAlive.swift for why a keep-alive is needed
	     at all: bluetooth-peripheral keeps a peripheral wakeable for incoming
	     events, but this one is push-driven, so once suspended nothing arrives
	     to wake it and the stream stops. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Keeps Sophon running while it streams motion in the background. Your location is never recorded or sent anywhere.</string>

	<!-- bluetooth-peripheral keeps the GATT server registered while backgrounded.
	     location is the keep-alive that keeps the process scheduled so CoreMotion
	     and the notify loop keep running; CLLocationManager throws at runtime if
	     allowsBackgroundLocationUpdates is set without it, so this entry and that
	     line are a single change. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-peripheral</string>
		<string>location</string>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
